{
  "openapi": "3.0.0",
  "info": {
    "title": "Vehicle List API",
    "version": "1.0.0",
    "description": "API responsável pela consulta de veículos"
  },
  "servers": [
    {
      "url": "http://localhost:3002"
    }
  ],
  "paths": {
    "/vehicles": {
      "get": {
        "summary": "Lista veículos",
        "parameters": [
          {
            "name": "brand",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "year",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Lista de veículos"
          }
        }
      }
    },
    "/vehicles/{id}": {
      "get": {
        "summary": "Busca um veículo",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Veículo encontrado"
          },
          "404": {
            "description": "Veículo não encontrado"
          }
        }
      }
    }
  }
}